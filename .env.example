# ElectroGuard Environment Configuration
# Project: ElectroGuard - Smart Electrical Worker Safety & Maintenance Coordination
# Team: GodsPlanKangra (Aayan Parmar, Manjinder Uldeen, Aayush Parmar)

APP_NAME="ElectroGuard"
APP_ENV="prototype"
APP_DEBUG=true
APP_URL="http://localhost:8000"

# Database connection: 'sqlite' or 'mysql'
DB_CONNECTION=sqlite

# MySQL Settings (Only used if DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=electroguard
DB_USERNAME=root
DB_PASSWORD=

# Session Lifetime (seconds)
SESSION_LIFETIME=7200
